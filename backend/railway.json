{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "go build -o bin/ymaps ./cmd/ymaps",
    "watchPatterns": ["/backend/**"]
  },
  "deploy": {
    "startCommand": "./bin/ymaps",
    "healthcheckPath": "/v1/hello",
    "restartPolicyType": "ON_FAILURE"
  }
}
